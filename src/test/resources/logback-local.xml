<?xml version="1.0" encoding="UTF-8"?>
<!--
    Human-readable logging for the local run (runLocal / LocalApp). Selected through the
    logback.configurationFile system property set by the runLocal task, leaving production logging
    (JSON through logback.xml) untouched. It lives in src/test/resources and never enters the production JAR.
-->
<configuration>
    <appender name="stdout_human" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.apache.kafka" level="WARN" />
    <logger name="org.testcontainers" level="INFO" />
    <logger name="tc" level="WARN" />
    <logger name="com.github.dockerjava" level="WARN" />

    <root level="info">
        <appender-ref ref="stdout_human" />
    </root>
</configuration>
